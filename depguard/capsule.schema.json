{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DepGuard Dependency Exit Capsule",
  "type": "object",
  "required": ["capsule_version", "generated_at", "repository", "dependencies", "risk_evidence", "usage",
               "ai_recommendations", "migration_proposal", "suggested_tests", "executed_tests",
               "compatibility_gaps", "model", "limitations"],
  "properties": {
    "capsule_version": {"const": "1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "repository": {"type": "object", "required": ["path_name", "remote", "commit", "dirty"],
      "properties": {"path_name": {"type": "string"}, "remote": {"type": ["string", "null"]},
                     "commit": {"type": ["string", "null"]}, "dirty": {"type": ["boolean", "null"]}}},
    "dependencies": {"type": "object", "description": "OBSERVED manifest facts",
      "required": ["manifests", "python_requires", "items", "parse_issues"],
      "properties": {"manifests": {"type": "array", "items": {"type": "string"}},
                     "python_requires": {"type": ["string", "null"]},
                     "parse_issues": {"type": "array"},
                     "items": {"type": "array", "items": {"type": "object",
                       "required": ["name", "specifier", "pinned_version", "resolved_version", "file", "line"],
                       "properties": {"resolved_version": {"type": ["string", "null"]}}}}}},
    "risk_evidence": {"type": "object", "description": "OBSERVED, rule-based indicators",
      "required": ["indicators", "package_levels"]},
    "usage": {"type": "object",
      "required": ["usages", "undeclared_imports", "no_import_found", "dynamic_import_sites", "limitations"]},
    "ai_recommendations": {"type": "object", "description": "MODEL OUTPUT, not verified fact", "required": ["status"],
      "properties": {"status": {"enum": ["ok", "blocked", "invalid_response", "not_requested"]},
                     "reason": {"type": "string"},
                     "recommendations": {"type": "array"}}},
    "migration_proposal": {"type": "object", "required": ["status", "accepted_edits", "rejected_edits", "diff"],
      "properties": {"status": {"enum": ["proposed", "none"]}, "accepted_edits": {"type": "array"},
                     "rejected_edits": {"type": "array"}, "diff": {"type": "string"}}},
    "suggested_tests": {"type": "array", "items": {"type": "string"},
      "description": "MODEL suggestions, not executed"},
    "executed_tests": {"type": "object", "description": "ACTUALLY RUN commands and results",
      "required": ["baseline", "proposed", "comparison"],
      "properties": {"baseline": {"$ref": "#/$defs/run"}, "proposed": {"$ref": "#/$defs/run"},
                     "comparison": {"type": ["object", "null"]}}},
    "compatibility_gaps": {"type": "array", "items": {"type": "string"}},
    "model": {"type": "object", "required": ["available", "model"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"run": {"type": "object", "required": ["status"],
    "properties": {"status": {"enum": ["passed", "failed", "skipped", "not_run", "environment_blocked"]},
                   "steps": {"type": "array"}, "tests": {"type": "object"}}}}
}
